# Ollama Configuration
OLLAMA_HOST=http://localhost:11434

# Default model for all modes
NEXI_MODEL_DEFAULT=llama3.1:8b

# Optional: Per-mode model overrides
# NEXI_MODEL_REACT=llama3.2:3b
# NEXI_MODEL_CHAT=llama3.1:8b
# NEXI_MODEL_THINK=llama3.1:70b
# NEXI_MODEL_OFFLINE=llama3.1:8b

# Data directory (optional, defaults to ./data)
# NEXI_DATA_DIR=./data

# Discord bot runtime settings
# DISCORD_TOKEN=your_discord_bot_token_here
# DISCORD_MODE=dm
# DISCORD_PREFIX=!nexi
# DISCORD_ALLOWED_GUILD_ID=123456789012345678

# Performance tuning
# NEXI_USE_SEMANTIC_MEMORY=true
